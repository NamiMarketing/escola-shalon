{
  "name": "escola-shalon",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm-run-all build:css build:html",
    "build:css": "sass src/sass/:public/css/ --no-source-map --style=compressed",
    "build:html": "eleventy",
    "dev": "npm-run-all --parallel watch:css watch:html",
    "watch:css": "sass --watch src/sass/:src/css/ --no-source-map --style=compressed",
    "watch:html": "eleventy --serve --watch=_data/i18n/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eleventy-plugin-i18n": "^0.1.3",
    "imagemin": "^8.0.1",
    "imagemin-webp": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.89.2"
  }
}
