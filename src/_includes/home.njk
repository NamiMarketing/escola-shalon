<script>
  (function () {
    const overlay = document.getElementById("popup-2027");
    const screen1 = overlay.querySelector(".popup-2027-screen1");
    const screen2 = overlay.querySelector(".popup-2027-screen2");

    overlay.classList.add("active");

    overlay.querySelectorAll(".popup-2027-close").forEach((btn) => {
      btn.addEventListener("click", () => overlay.classList.remove("active"));
    });

    overlay.querySelector(".popup-2027-next").addEventListener("click", () => {
      screen1.classList.remove("active");
      screen2.classList.add("active");
    });

    overlay.querySelectorAll(".popup-2027-grade").forEach((btn) => {
      btn.addEventListener("click", () => {
        const grade = btn.dataset.grade;
        const text = encodeURIComponent(
          `Olá! Estou interessado na turma de ${grade} e gostaria de mais informações.`
        );
        window.open(
          `https://api.whatsapp.com/send?phone=5541984475964&text=${text}`,
          "_blank"
        );
      });
    });
  })();
</script>

<script>
   document.getElementById("lang-toggle").addEventListener("change", function () {
  const selectedLang = this.checked ? 'en' : 'pt';
  urlHandler(selectedLang);
});

function urlHandler(lang) {
  // Redireciona para a versão do idioma
  if (lang === 'pt') {
    window.location.href = '/pt';
  } else if (lang === 'en') {
    window.location.href = '/en';
  }
}
</script>
